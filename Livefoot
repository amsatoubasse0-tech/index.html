<!DOCTYPE html>
<html>
<head>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>FootLive</title>

<style>
body{
  font-family: Arial;
  background: #0f172a;
  color: white;
  text-align: center;
}

h1{
  color: #38bdf8;
}

.match{
  background: #1e293b;
  margin: 10px;
  padding: 15px;
  border-radius: 10px;
}

button{
  background: #22c55e;
  border: none;
  padding: 12px;
  border-radius: 8px;
  font-size: 16px;
  color: white;
  cursor: pointer;
}
</style>
</head>

<body>

<h1>⚽ FootLive</h1>

<button onclick="refreshScores()">Refresh</button>

<div id="matches"></div>

<script>
// Ta clé API
const apiKey = "79a32d3f3a2985a134a3cf11f5141033";

// Fonction pour récupérer les scores en direct depuis API-Football
async function refreshScores() {
  try {
    const response = await fetch("https://v3.football.api-sports.io/fixtures?live=all", {
      method: "GET",
      headers: {
        "x-apisports-key": apiKey
      }
    });
    const data = await response.json();

    if (!data.response || data.response.length === 0) {
      document.getElementById("matches").innerHTML = "<p>Aucun match en direct pour le moment.</p>";
      return;
    }

    let html = "";
    data.response.forEach(item => {
      const team1 = item.teams.home.name;
      const team2 = item.teams.away.name;
      const score = `${item.goals.home} - ${item.goals.away}`;
      html += `
      <div class="match">
        <h3>${team1} vs ${team2}</h3>
        <h2>${score}</h2>
      </div>
      `;
    });

    document.getElementById("matches").innerHTML = html;

  } catch (error) {
    console.error("Erreur en récupérant les scores:", error);
    document.getElementById("matches").innerHTML = "<p>Impossible de charger les scores pour le moment.</p>";
  }
}

// Charger les scores dès l'ouverture du site
refreshScores();
</script>

</body>
</html>
